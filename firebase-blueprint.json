{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "A chess club player with Elo rating and match performance statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique player ID (UUID or slug)" },
        "name": { "type": "string", "description": "Full player display name" },
        "currentRating": { "type": "number", "description": "Current active Elo rating" },
        "initialRating": { "type": "number", "description": "Starting Elo rating (e.g. 1400)" },
        "peakRating": { "type": "number", "description": "Highest recorded Elo rating" },
        "category": { "type": "string", "enum": ["Open", "Junior", "Veteran", "Women"], "description": "Player category division" },
        "gamesPlayed": { "type": "number", "description": "Total completed games count" },
        "wins": { "type": "number", "description": "Total games won" },
        "draws": { "type": "number", "description": "Total games drawn" },
        "losses": { "type": "number", "description": "Total games lost" },
        "whiteWins": { "type": "number", "description": "Games won playing White pieces" },
        "blackWins": { "type": "number", "description": "Games won playing Black pieces" },
        "joinDate": { "type": "string", "description": "ISO date player joined club" },
        "lastActiveDate": { "type": "string", "description": "ISO date of last recorded game" },
        "attendanceCount": { "type": "number", "description": "Club sessions attended" },
        "notes": { "type": "string", "description": "Optional organizer notes or FIDE ID" },
        "updatedAt": { "type": "string", "description": "Timestamp of last modification" }
      },
      "required": ["id", "name", "currentRating", "initialRating", "peakRating", "category", "gamesPlayed", "wins", "draws", "losses"]
    },
    "Match": {
      "title": "Match",
      "description": "A chess match between two club players with ratings and Elo adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique match record ID" },
        "date": { "type": "string", "description": "ISO date string or YYYY-MM-DD format" },
        "boardNumber": { "type": "number", "description": "Optional board assignment number" },
        "whitePlayerId": { "type": "string", "description": "Player ID for White" },
        "whitePlayerName": { "type": "string", "description": "Name of White player" },
        "whiteRatingBefore": { "type": "number", "description": "White rating before game" },
        "whiteRatingAfter": { "type": "number", "description": "White rating after game" },
        "whiteDelta": { "type": "number", "description": "Elo change for White" },
        "blackPlayerId": { "type": "string", "description": "Player ID for Black" },
        "blackPlayerName": { "type": "string", "description": "Name of Black player" },
        "blackRatingBefore": { "type": "number", "description": "Black rating before game" },
        "blackRatingAfter": { "type": "number", "description": "Black rating after game" },
        "blackDelta": { "type": "number", "description": "Elo change for Black" },
        "result": { "type": "string", "enum": ["1-0", "0-1", "1/2-1/2"], "description": "Standard chess game outcome notation" },
        "timeControl": { "type": "string", "enum": ["Classical", "Rapid", "Blitz"], "description": "Game time control" },
        "roundName": { "type": "string", "description": "Round or tournament label" },
        "openingOrNotes": { "type": "string", "description": "Opening code, variation or game notes" },
        "createdAt": { "type": "string", "description": "Timestamp when match was recorded" }
      },
      "required": ["id", "date", "whitePlayerId", "whitePlayerName", "blackPlayerId", "blackPlayerName", "result", "timeControl"]
    },
    "VersionSnapshot": {
      "title": "VersionSnapshot",
      "description": "Rating and roster backup snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Snapshot ID" },
        "name": { "type": "string", "description": "Descriptive snapshot title" },
        "description": { "type": "string", "description": "Description of the milestone or season" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "playersCount": { "type": "number", "description": "Total players at snapshot time" },
        "matchesCount": { "type": "number", "description": "Total matches at snapshot time" },
        "players": { "type": "array", "description": "Serialized list of players in snapshot" },
        "matches": { "type": "array", "description": "Serialized list of matches in snapshot" }
      },
      "required": ["id", "name", "createdAt", "playersCount", "matchesCount"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Persisted chess club player documents containing Elo ratings and stats"
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Persisted chess club match documents containing results and Elo deltas"
    },
    "/snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/VersionSnapshot" },
      "description": "Persisted snapshots and version checkpoints for the club"
    }
  }
}
